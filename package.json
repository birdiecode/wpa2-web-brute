{
  "name": "wpa2-web-brute",
  "version": "1.0.0",
  "description": "WPA2 PMK, PTK and MIC with WebCrypto, WebGL2 and WebGPU",
  "license": "MIT",
  "type": "module",
  "main": "./dist/wpa2-web-brute.full.cjs",
  "module": "./dist/wpa2-web-brute.full.mjs",
  "types": "./dist/wpa2-web-brute.full.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wpa2-web-brute.full.d.ts",
      "import": "./dist/wpa2-web-brute.full.mjs",
      "require": "./dist/wpa2-web-brute.full.cjs"
    },
    "./full": {
      "types": "./dist/wpa2-web-brute.full.d.ts",
      "import": "./dist/wpa2-web-brute.full.mjs",
      "require": "./dist/wpa2-web-brute.full.cjs"
    },
    "./webcrypto": {
      "types": "./dist/wpa2-web-brute.webcrypto.d.ts",
      "import": "./dist/wpa2-web-brute.webcrypto.mjs",
      "require": "./dist/wpa2-web-brute.webcrypto.cjs"
    },
    "./webgl": {
      "types": "./dist/wpa2-web-brute.webgl.d.ts",
      "import": "./dist/wpa2-web-brute.webgl.mjs",
      "require": "./dist/wpa2-web-brute.webgl.cjs"
    },
    "./webgpu": {
      "types": "./dist/wpa2-web-brute.webgpu.d.ts",
      "import": "./dist/wpa2-web-brute.webgpu.mjs",
      "require": "./dist/wpa2-web-brute.webgpu.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:cli": "node --test tests/cli.test.mjs",
    "test": "npm run build && npm run typecheck && npm run test:cli && node --test tests/package.test.mjs tests/webgl-pmk-resources.test.mjs",
    "prepack": "npm run build",
    "cli": "node bin/wpa2-web-brute.mjs",
    "test:browser": "npm run build && WPA2_BROWSER_TEST=1 node --test --test-concurrency=1 tests/cli.test.mjs tests/gpu-browser.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "puppeteer": "^24.43.1"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "bin": {
    "wpa2-web-brute": "./bin/wpa2-web-brute.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer": "^24.43.1",
    "typescript": "^5.9.3"
  }
}
